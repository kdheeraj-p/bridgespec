+#if defined(DATA_A_IQ4_XS)
+// 4-byte loads for IQ4_XS blocks (136 bytes); kvalues served from shared memory (see PR #10409)
+i32vec4 repack4(uint ib_k, uint ib32, uint iqs) {
+    // iqs == 0: low nibbles (elements 0..15), iqs == 1: high nibbles (elements 16..31)
+    const uint shift = 4 * iqs;
+    const uint32_t v0 = (data_a_packed32[ib_k].qs[4 * ib32    ] >> shift) & 0x0F0F0F0F;
+    const uint32_t v1 = (data_a_packed32[ib_k].qs[4 * ib32 + 1] >> shift) & 0x0F0F0F0F;
+    const uint32_t v2 = (data_a_packed32[ib_k].qs[4 * ib32 + 2] >> shift) & 0x0F0F0F0F;
+    const uint32_t v3 = (data_a_packed32[ib_k].qs[4 * ib32 + 3] >> shift) & 0x0F0F0F0F;
+
+    const u8vec4 i0 = unpack8(v0);
+    const u8vec4 i1 = unpack8(v1);
+    const u8vec4 i2 = unpack8(v2);
+    const u8vec4 i3 = unpack8(v3);
+
+    return i32vec4(pack32(i8vec4(kvalues_iq4nl_i8[i0.x], kvalues_iq4nl_i8[i0.y], kvalues_iq4nl_i8[i0.z], kvalues_iq4nl_i8[i0.w])),
+                   pack32(i8vec4(kvalues_iq4nl_i8[i1.x], kvalues_iq4nl_i8[i1.y], kvalues_iq4nl_i8[i1.z], kvalues_iq4nl_i8[i1.w])),
+                   pack32(i8vec4(kvalues_iq4nl_i8[i2.x], kvalues_iq4nl_i8[i2.y], kvalues_iq4nl_i8[i2.z], kvalues_iq4nl_i8[i2.w])),
+                   pack32(i8vec4(kvalues_iq4nl_i8[i3.x], kvalues_iq4nl_i8[i3.y], kvalues_iq4nl_i8[i3.z], kvalues_iq4nl_i8[i3.w])));
+}
+
+float get_d_scale(uint ib_k, uint ib32) {
+    const uint sl = (data_a_packed32[ib_k].scales_l >> (8 * (ib32 >> 1) + 4 * (ib32 & 1))) & 0xF;
+    const uint sh = (uint(data_a_packed32[ib_k].scales_h) >> (2 * ib32)) & 3;
+    return float(data_a_packed32[ib_k].d) * float(int(sl | (sh << 4)) - 32);
+}
+
+FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
+    const uint ib_k = ib_a / 8;
+    const uint ib32 = ib_a % 8;
+
+    int32_t q_sum = 0;
+    const i32vec4 qs_a = repack4(ib_k, ib32, iqs);
+    const float d_scale = get_d_scale(ib_k, ib32);
+
+    q_sum += dotPacked4x8EXT(qs_a.x, cache_b_qs[0]);
+    q_sum += dotPacked4x8EXT(qs_a.y, cache_b_qs[1]);
+    q_sum += dotPacked4x8EXT(qs_a.z, cache_b_qs[2]);
+    q_sum += dotPacked4x8EXT(qs_a.w, cache_b_qs[3]);
+
+    // kvalues are signed and unbiased, no q8_1 sum correction needed
+    return FLOAT_TYPE(float(cache_b_ds.x) * d_scale * float(q_sum));
+}
+#endif
